{
  "name": "systeme_electorale_blockchain_backend",
  "version": "1.0.0",
  "description": "Backend TFC Système électoral Blockchain",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prod": "NODE_ENV=production npm start",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false node ethereum/compile.js && npm install --prefix frontend && npm run build --prefix frontend"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.6.2",
    "@truffle/hdwallet-provider": "^2.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.1",
    "cloudinary": "^1.28.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "fs-extra": "^10.0.0",
    "ganache-cli": "^6.12.2",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.13.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.4",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.7.2",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "solc": "^0.8.11",
    "validator": "^13.7.0",
    "web3": "^1.7.0"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.15"
  }
}
